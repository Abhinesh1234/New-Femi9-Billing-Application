# Staging environment shape — DOCUMENTATION ONLY.
#
# This file is NOT read by the pipeline or by the running container. The staging
# container gets its configuration two ways:
#   1. Plain values  -> set as `environment` in the ECS task definition
#                       (infra/terraform/ecs.tf).
#   2. Secret values -> injected at runtime by ECS from AWS Secrets Manager
#                       (secret `femi9/staging/app-env`, see infra/terraform/secrets.tf).
#
# Keep this file in sync with ecs.tf so a new engineer can see, at a glance,
# what staging expects. The image runs PHP 8.4 (docker/php/Dockerfile).

# --- Plain values (mirrored from the task definition `environment` block) ---
APP_ENV=staging
APP_DEBUG=false
DB_CONNECTION=mysql
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=s3
MAIL_MAILER=log
AWS_DEFAULT_REGION=us-east-1

# --- Injected at runtime by ECS from Secrets Manager (femi9/staging/app-env) ---
# Never commit real values for these. Listed here only so the shape is known.
# APP_KEY=          # base64 Laravel app key
# DB_HOST=          # Aurora Serverless v2 writer endpoint
# DB_DATABASE=      # staging database name
# DB_USERNAME=      # Aurora master username
# DB_PASSWORD=      # Aurora master password
# REDIS_HOST=       # ElastiCache Redis primary endpoint
# AWS_BUCKET=       # S3 bucket for the `s3` filesystem disk
